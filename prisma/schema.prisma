generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  LEARNER
  MODERATOR
  EDUCATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum PublishStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LessonType {
  ARTICLE
  INTERACTIVE
  VIDEO
  QUIZ
  QUEST_BRIEF
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum QuestType {
  LEARN
  COMMUNITY
  ONCHAIN
  WORKSHOP
}

enum VerificationType {
  MANUAL
  QUIZ_SCORE
  WALLET_CONNECT
  ONCHAIN_TX
  LINK_SUBMISSION
  TEXT_SUBMISSION
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  NEEDS_REVIEW
  APPROVED
  REJECTED
}

enum RewardKind {
  XP
  TOKEN
  NFT
  BADGE
}

enum RewardDirection {
  CREDIT
  DEBIT
}

enum WorkshopStatus {
  DRAFT
  OPEN
  CLOSED
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  REGISTERED
  WAITLISTED
  ATTENDED
  CANCELLED
  NO_SHOW
}

enum AiGenerationStatus {
  QUEUED
  COMPLETED
  FAILED
}

model User {
  id           String     @id @default(cuid())
  email        String?    @unique
  username     String     @unique @db.VarChar(32)
  displayName  String     @db.VarChar(80)
  passwordHash String?
  role         UserRole   @default(LEARNER)
  status       UserStatus @default(ACTIVE)

  locale    String  @default("id-ID") @db.VarChar(16)
  city      String? @db.VarChar(80)
  avatarUrl String?
  bio       String?

  xp           Int       @default(0)
  level        Int       @default(1)
  streakCount  Int       @default(0)
  lastActiveAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions              Session[]
  wallets               Wallet[]
  enrollments           Enrollment[]
  lessonProgress        LessonProgress[]
  questSubmissions      QuestSubmission[]      @relation("QuestSubmissionAuthor")
  reviewedSubmissions   QuestSubmission[]      @relation("QuestSubmissionReviewer")
  rewardLedger          RewardLedger[]
  badges                UserBadge[]
  workshopRegistrations WorkshopRegistration[]
  aiGenerations         AiGeneration[]
  readinessProfile      ReadinessProfile?
  proofRecords          ProofRecord[]

  createdCourses Course[] @relation("CourseCreator")
  createdLessons Lesson[] @relation("LessonCreator")

  @@index([role])
  @@index([status])
  @@map("users")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Wallet {
  id         String    @id @default(cuid())
  userId     String
  chainKey   String    @db.VarChar(40)
  networkKey String    @default("mainnet") @db.VarChar(40)
  address    String    @db.VarChar(160)
  label      String?   @db.VarChar(60)
  isPrimary  Boolean   @default(false)
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chainKey, networkKey, address])
  @@index([userId])
  @@map("wallets")
}

model Course {
  id            String        @id @default(cuid())
  slug          String        @unique @db.VarChar(120)
  title         String        @db.VarChar(160)
  subtitle      String?       @db.VarChar(220)
  description   String?
  locale        String        @default("id-ID") @db.VarChar(16)
  difficulty    Difficulty    @default(BEGINNER)
  status        PublishStatus @default(DRAFT)
  coverImageUrl String?

  creatorId   String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  creator     User?          @relation("CourseCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  modules     CourseModule[]
  enrollments Enrollment[]
  quests      Quest[]

  @@index([status])
  @@index([difficulty])
  @@map("courses")
}

model CourseModule {
  id          String   @id @default(cuid())
  courseId    String
  order       Int
  title       String   @db.VarChar(160)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, order])
  @@index([courseId])
  @@map("course_modules")
}

model Lesson {
  id        String        @id @default(cuid())
  moduleId  String
  creatorId String?
  slug      String        @db.VarChar(120)
  order     Int
  title     String        @db.VarChar(160)
  type      LessonType    @default(ARTICLE)
  status    PublishStatus @default(DRAFT)

  content          Json
  resources        Json?
  estimatedMinutes Int     @default(5)
  xpReward         Int     @default(0)
  isRequired       Boolean @default(true)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  module  CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  creator User?        @relation("LessonCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  questions QuizQuestion[]
  progress  LessonProgress[]
  quests    Quest[]

  @@unique([moduleId, slug])
  @@unique([moduleId, order])
  @@index([status])
  @@map("lessons")
}

model QuizQuestion {
  id          String  @id @default(cuid())
  lessonId    String
  order       Int
  prompt      String
  options     Json
  answer      Json
  explanation String?
  points      Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, order])
  @@index([lessonId])
  @@map("quiz_questions")
}

model Enrollment {
  id          String         @id @default(cuid())
  userId      String
  courseId    String
  status      ProgressStatus @default(IN_PROGRESS)
  progressPct Int            @default(0)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

model LessonProgress {
  id          String         @id @default(cuid())
  userId      String
  lessonId    String
  status      ProgressStatus @default(NOT_STARTED)
  score       Int?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model Quest {
  id       String  @id @default(cuid())
  courseId String?
  lessonId String?

  slug        String        @unique @db.VarChar(120)
  title       String        @db.VarChar(160)
  description String?
  type        QuestType     @default(LEARN)
  difficulty  Difficulty    @default(BEGINNER)
  status      PublishStatus @default(DRAFT)

  xpReward          Int      @default(0)
  tokenRewardAmount Decimal? @db.Decimal(20, 8)
  tokenSymbol       String?  @db.VarChar(24)
  chainKey          String?  @db.VarChar(40)

  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  tasks       QuestTask[]
  submissions QuestSubmission[]
  rewards     RewardLedger[]

  @@index([status])
  @@index([type])
  @@index([courseId])
  @@map("quests")
}

model QuestTask {
  id                 String           @id @default(cuid())
  questId            String
  order              Int
  title              String           @db.VarChar(160)
  instructions       String?
  verificationType   VerificationType @default(MANUAL)
  verificationConfig Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([questId, order])
  @@index([questId])
  @@map("quest_tasks")
}

model QuestSubmission {
  id         String  @id @default(cuid())
  userId     String
  questId    String
  reviewerId String?

  status     SubmissionStatus @default(SUBMITTED)
  evidence   Json?
  score      Int?
  reviewNote String?

  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User  @relation("QuestSubmissionAuthor", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("QuestSubmissionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  quest    Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
  @@index([questId])
  @@index([status])
  @@map("quest_submissions")
}

model RewardLedger {
  id      String  @id @default(cuid())
  userId  String
  questId String?

  kind      RewardKind
  direction RewardDirection @default(CREDIT)

  xpAmount    Int?
  tokenAmount Decimal? @db.Decimal(20, 8)
  tokenSymbol String?  @db.VarChar(24)
  chainKey    String?  @db.VarChar(40)
  txHash      String?  @db.VarChar(160)

  reason    String?  @db.VarChar(180)
  metadata  Json?
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest? @relation(fields: [questId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([questId])
  @@index([kind])
  @@map("reward_ledger")
}

model Badge {
  id          String   @id @default(cuid())
  slug        String   @unique @db.VarChar(120)
  name        String   @db.VarChar(120)
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserBadge[]

  @@map("badges")
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())
  metadata  Json?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([badgeId])
  @@map("user_badges")
}

model Workshop {
  id          String         @id @default(cuid())
  slug        String         @unique @db.VarChar(120)
  title       String         @db.VarChar(160)
  description String?
  city        String?        @db.VarChar(80)
  location    String?
  capacity    Int?
  status      WorkshopStatus @default(DRAFT)

  startsAt  DateTime
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  registrations WorkshopRegistration[]

  @@index([status])
  @@index([startsAt])
  @@map("workshops")
}

model WorkshopRegistration {
  id         String             @id @default(cuid())
  userId     String
  workshopId String
  status     RegistrationStatus @default(REGISTERED)
  attendedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@unique([userId, workshopId])
  @@index([workshopId])
  @@map("workshop_registrations")
}

model AiGeneration {
  id      String             @id @default(cuid())
  userId  String?
  purpose String             @db.VarChar(80)
  status  AiGenerationStatus @default(QUEUED)

  provider   String? @db.VarChar(80)
  model      String? @db.VarChar(120)
  input      Json?
  output     Json?
  error      String?
  tokensUsed Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([purpose])
  @@map("ai_generations")
}

enum ProofType {
  LEARNING
  PARTICIPATION
  READINESS
}

enum ReadinessLevel {
  BEGINNER
  LEARNING
  READY
  COMMUNITY_READY
}

model ReadinessProfile {
  id               String         @id @default(cuid())
  userId           String         @unique
  level            ReadinessLevel @default(BEGINNER)
  totalXp          Int            @default(0)
  completedCourses Int            @default(0)
  approvedQuests   Int            @default(0)
  workshopsJoined  Int            @default(0)
  readinessScore   Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  proofRecords ProofRecord[]

  @@index([level])
  @@map("readiness_profiles")
}

model ProofRecord {
  id                 String    @id @default(cuid())
  userId             String
  readinessProfileId String?
  type               ProofType
  title              String    @db.VarChar(160)
  description        String?
  source             String?   @db.VarChar(80)
  sourceId           String?
  xpValue            Int       @default(0)
  metadata           Json?
  archivedToFilecoin Boolean   @default(false)
  filecoinCid        String?   @db.VarChar(160)
  issuedAt           DateTime  @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  readinessProfile ReadinessProfile? @relation(fields: [readinessProfileId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([issuedAt])
  @@map("proof_records")
}
